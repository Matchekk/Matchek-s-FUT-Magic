{
  "manifest_version": 3,
  "name": "FUT Magic",
  "version": "2.3.0",
  "minimum_chrome_version": "120",
  "description": "Smarter plans. Better results. Local-first SBC planning, protected grinding, projects, and safe recovery.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FUT Magic",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["storage", "scripting", "sidePanel"],
  "host_permissions": [
    "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
    "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self'"
  },
  "content_scripts": [
    {
      "js": [
        "content-script.js",
        "src/generated/grindpilot-content-bundle.js"
      ],
      "run_at": "document_start",
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page/ea-data-bridge.js",
        "page/ea-data-bridge.css",
        "data/changelog.json"
      ],
      "matches": [
        "https://www.ea.com/*"
      ]
    }
  ]
}
